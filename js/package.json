{
  "name": "@ffans/link-guard",
  "private": true,
  "version": "0.0.0",
  "devDependencies": {
    "@flarum/jest-config": "^1.0.1",
    "@askvortsov/rich-icu-message-formatter": "^0.2.4",
    "@ultraq/icu-message-formatter": "^0.12.0",
    "@types/node": "18.19.0",
    "@types/jquery": "^3.5.10",
    "@types/js-yaml": "^4.0.9",
    "clsx": "^1.1.1",
    "dayjs": "^1.11.23",
    "flarum-tsconfig": "^1.0.3",
    "flarum-webpack-config": "^2.0.2",
    "jquery": "^3.7.1",
    "mithril": "~2.0.4",
    "oxfmt": "^0.66.0",
    "typescript": "~4.9.5",
    "typescript-coverage-report": "0.8.0",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "analyze": "cross-env ANALYZER=true npm run build",
    "format": "oxfmt src",
    "format-check": "oxfmt --check src",
    "clean-typings": "npx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "node scripts/build-typings.mjs",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false",
    "check-typings-coverage": "typescript-coverage-report",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "type": "module",
  "volta": {
    "node": "26.8.1"
  }
}
